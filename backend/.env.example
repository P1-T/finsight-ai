# Optional for AI-composed plans and summaries. Set LLM_ENABLED=false to use the demo fallback without Claude API calls.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_ENABLED=true

# Required for SEC's public exchange-listed company directory. Use a real contact email.
SEC_USER_AGENT=FinSightAI/2.0 your-email@example.com
SEC_TIMEOUT_SECONDS=30
COMPANY_DIRECTORY_CACHE_SECONDS=86400

FRONTEND_ORIGIN=http://localhost:3000
WEB_SEARCH_TIMEOUT_SECONDS=12
MARKET_DATA_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=45
RESEARCH_TIMEOUT_SECONDS=90
CHAT_HISTORY_MESSAGES=4

# Optional LangSmith evaluation. The evaluation runner enables tracing for its benchmark run.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finsight-evals
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_EVAL_DATASET=FinSight Golden Evaluation v1
LANGSMITH_EVAL_JUDGE_MODEL=claude-haiku-4-5-20251001
